# =============================================================================
# ROSI STUDIO — Variables de Entorno (Configuración de Firebase)
# =============================================================================
# Copia este archivo a `.env.local` y rellena con las credenciales de tu consola
# de Firebase (https://console.firebase.google.com).
#
# NOTA DE SEGURIDAD:
# Las variables que comienzan con NEXT_PUBLIC_ son accesibles en el navegador.
# Firebase utiliza estas claves únicamente para identificar tu proyecto;
# la seguridad de los datos depende de las reglas en `firestore.rules`.
# NUNCA agregues claves privadas de cuentas de servicio en este archivo.
# =============================================================================

# Configuración del proyecto web de Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyTuClaveDeApiRealAqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto-rosi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-rosi
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto-rosi.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Correos de administradoras autorizadas para el bootstrap inicial
# (Separados por coma, en minúsculas)
NEXT_PUBLIC_ADMIN_EMAILS=administradora@rosistudio.com,gerencia@rosistudio.com

# Teléfono de WhatsApp para recepción de consultas (sin '+' ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=51987654321
